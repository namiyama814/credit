---
import '../styles/global.css';
interface Props { title: string; page: string; exercise?: boolean; }
const { title, page, exercise=false }=Astro.props;
const nav=[['/','学習'],['/questions/','問題'],['/analytics/','分析'],['/practice/','問題集'],['/history/','履歴'],['/settings/','設定']];
---
<!doctype html>
<html lang="ja">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>{title} | 情報Ⅰ</title><link rel="stylesheet" href="/fonts/noto.css" /><link rel="icon" href="/favicon.svg" /></head>
  <body class:list={{exercise}} data-page={page}>
    <header class="site-header"><a class="brand" href="/">情報Ⅰ</a>{!exercise && page!=='login' && <nav class="nav" aria-label="メイン">{nav.map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav>}{exercise && <a class="muted" href="/">中断して戻る</a>}</header>
    <main class:list={['main',{narrow:exercise||page==='login'}]} id="app"><slot /><p class="loading" role="status">読み込み中</p></main>
    <script>import '../client/app';</script>
  </body>
</html>
