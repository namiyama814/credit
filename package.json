{
  "name": "info1-study",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && vite --host 127.0.0.1",
    "build:web": "node scripts/prepare-assets.mjs && astro build && node scripts/version-service-worker.mjs",
    "build": "npm run build:web && vite build",
    "typecheck": "cf workers types && astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "import": "tsx scripts/import.ts",
    "deploy": "npm run check:deploy && npm run build && cf deploy --prebuilt --mode production --secrets-file .dev.vars",
    "dev:test": "npm run build:web && vite --mode test --host 127.0.0.1",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:test": "node scripts/migrate.mjs --test",
    "demo": "npm run db:migrate:test && npm run dev:test",
    "validate:source": "tsx scripts/import.ts --validate-only",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "astro": "^7.4.12",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "cf": "^1.0.0-beta.32",
    "miniflare": "^5.20261113.0-beta",
    "node": "^26.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
